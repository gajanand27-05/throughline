# Belt and braces on top of .gitignore. The API key must never leave this
# machine except as a Vercel environment variable (CLAUDE.md section 6).
.env
.env.local
.env.*
!.env.example

# Dev-only. Nothing here is imported by api/ at runtime.
tests/
requirements-dev.txt
run_fixtures.py
run_extraction.py
build_demo.py
pytest.ini
.pytest_cache/
__pycache__/
*.pyc

# TEMPORARY (2026-09-26): Vercel CLI 60.x demands a single Python entrypoint
# via pyproject.toml, which would break the multi-function design that
# session.py and extract.py need. The demo page is fully static and
# self-contained, so ship that now and solve the runtime separately.
api/
engine/
extraction/
fixtures/
requirements.txt
